{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temas-items.schema.json",
  "title": "Teletipos clasificados por tema (src/data/temas-items.json)",
  "description": "La lista de teletipos de agencia detrás del gráfico de temas de cada tarjeta. Reglas cruzadas (ids y URLs únicos, fechas dentro del periodo, id que empieza por su fecha, un solo tema por evento, eventos de un día como mucho, al menos un evento de política por partido) las comprueba validateTemas en procesado/src/lib/temas.ts.",
  "type": "object",
  "required": [
    "periodo",
    "metodo",
    "items"
  ],
  "properties": {
    "periodo": {
      "type": "object",
      "required": [
        "desde",
        "hasta"
      ],
      "properties": {
        "desde": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Fecha ISO (AAAA-MM-DD); el validador rechaza fechas imposibles."
        },
        "hasta": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Fecha ISO (AAAA-MM-DD); el validador rechaza fechas imposibles."
        }
      }
    },
    "metodo": {
      "type": "string",
      "minLength": 1,
      "description": "Descripción del método de recogida y clasificación."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "fecha",
          "partidos",
          "titulo",
          "url",
          "agencia",
          "tema",
          "evento"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "<fecha>-<slug de la URL>."
          },
          "fecha": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Fecha ISO (AAAA-MM-DD); el validador rechaza fechas imposibles."
          },
          "partidos": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "frente-amplio",
                "podemos",
                "pp",
                "psoe",
                "vox"
              ]
            }
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          },
          "agencia": {
            "enum": [
              "EFE",
              "Europa Press",
              "desconocida"
            ]
          },
          "tema": {
            "enum": [
              "TRA",
              "VIV",
              "COR",
              "SEG",
              "INM",
              "PEN",
              "ECO",
              "EMP",
              "SOC",
              "TER",
              "EDU",
              "EXT",
              "MED",
              "SAN",
              "IGU",
              "OTR",
              "POL"
            ],
            "description": "Un solo tema por teletipo. POL (campaña) se cuenta aparte y se excluye del gráfico."
          },
          "evento": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Compartido por todos los teletipos del mismo acto o declaración (por convención, el id del primero). Cada evento cuenta una vez."
          }
        }
      }
    }
  }
}
