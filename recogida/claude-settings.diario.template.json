{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [],
    "deny": [
      "Bash",
      "PowerShell",
      "Monitor",
      "NotebookEdit",
      "Skill",
      "mcp__*",
      "Write(//**/.claude/**)",
      "Edit(//**/.claude/**)",
      "Write(//**/CLAUDE.md)",
      "Edit(//**/CLAUDE.md)",
      "Write(//**/.mcp.json)",
      "Edit(//**/.mcp.json)",
      "Write(//**/.git/**)",
      "Edit(//**/.git/**)",
      "Write(//**/*.ts)",
      "Edit(//**/*.ts)",
      "Write(//**/*.js)",
      "Edit(//**/*.js)",
      "Write(//**/*.mjs)",
      "Edit(//**/*.mjs)",
      "Write(//**/*.cjs)",
      "Edit(//**/*.cjs)",
      "Write(/__EJ__/antes/**)",
      "Edit(/__EJ__/antes/**)",
      "Write(/__EJ__/claude/**)",
      "Edit(/__EJ__/claude/**)",
      "Write(/__N29_CACHE__/docs/**)",
      "Edit(/__N29_CACHE__/docs/**)",
      "Write(/__N29_CACHE__/bloqueados.json)",
      "Edit(/__N29_CACHE__/bloqueados.json)",
      "Write(/__T__/**)",
      "Edit(/__T__/**)",
      "Write(/__CONF__/**)",
      "Edit(/__CONF__/**)",
      "Read(/__CONF__/**)",
      "Read(/__EJ__/diario.log)",
      "Read(/__EJ__/claude/**)",
      "Read(/__N29_CACHE__/launchd.log)",
      "Read(/__N29_CACHE__/ejecuciones/*/diario.log)",
      "Read(/__HOME__/.ssh/**)",
      "Read(/__HOME__/.aws/**)",
      "Read(/__HOME__/.config/**)",
      "Read(/__HOME__/.claude/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)"
    ]
  },
  "disableAllHooks": true,
  "enableAllProjectMcpServers": false
}
